<?xml version="1.0" encoding="utf-8"?>
<!-- RECOGNIZE_SPEECH for other apps: a listening pill at the bottom over the calling app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="@dimen/hud_margin"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="@dimen/hud_padding">

        <TextView
            android:id="@+id/label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/listening"
            android:textColor="@color/voice_hud_text"
            android:textSize="@dimen/hud_text"
            android:textStyle="bold" />

        <com.example.jaecoovoice.ui.VoiceWaveView
            android:id="@+id/waves"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hud_wave_height" />
    </LinearLayout>
</FrameLayout>
